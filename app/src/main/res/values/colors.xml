<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══ Material 3 light scheme (teal/mint accent) ═══ -->
    <!-- Same token names as values-night/colors.xml — layouts and themes.xml are shared, so
         every name defined here must also exist there, and vice versa. -->

    <color name="md_primary">#006B5B</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#9EF7DF</color>
    <color name="md_on_primary_container">#00201A</color>

    <color name="md_secondary">#4A635C</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#CCE8DF</color>
    <color name="md_on_secondary_container">#06201A</color>

    <color name="md_tertiary">#3F6375</color>
    <color name="md_on_tertiary">#FFFFFF</color>

    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>

    <color name="md_background">#F5FAF7</color>
    <color name="md_on_background">#171D1B</color>

    <color name="md_surface">#F5FAF7</color>
    <color name="md_on_surface">#171D1B</color>
    <color name="md_surface_variant">#E3EBE7</color>
    <color name="md_on_surface_variant">#3F4945</color>

    <color name="md_outline">#6F7975</color>
    <color name="md_outline_variant">#C3CCC7</color>
    <color name="md_inverse_surface">#2B3230</color>
    <color name="md_inverse_on_surface">#ECF2EE</color>

    <!-- ═══ Legacy aliases (kept for existing layouts) ═══ -->
    <!-- Note `primary` is the page ground, not the brand colour — layouts use it as the text
         colour on accent-tinted buttons, which inverts correctly across both palettes. -->

    <color name="primary">@color/md_background</color>
    <color name="primary_dark">#E7EEEA</color>
    <color name="primary_variant">@color/md_surface_variant</color>

    <color name="accent">@color/md_primary</color>
    <color name="accent_dark">#004F43</color>
    <color name="accent_light">#3E8C7A</color>

    <color name="surface">@color/md_surface</color>
    <color name="surface_light">@color/md_surface_variant</color>
    <color name="card_bg">@color/md_surface_variant</color>
    <color name="card_stroke">@color/md_outline_variant</color>

    <color name="text_primary">@color/md_on_surface</color>
    <color name="text_secondary">@color/md_on_surface_variant</color>
    <color name="text_hint">@color/md_outline</color>

    <color name="success">#116B52</color>
    <color name="warning">#845400</color>
    <color name="error">@color/md_error</color>
    <color name="info">#12559C</color>

    <color name="fab_bg">@color/md_primary</color>
    <color name="fab_icon">@color/md_on_primary</color>

    <color name="divider">@color/md_outline_variant</color>
    <color name="ripple">#22006B5B</color>
    <color name="status_bar">@color/md_surface</color>
    <color name="nav_bar">@color/md_surface</color>

    <!-- Launcher icon background stays fixed; the icon does not follow app night mode. -->
    <color name="ic_launcher_adaptive_bg">#155E63</color>
</resources>
